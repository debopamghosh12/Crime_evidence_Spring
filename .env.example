# L3: copy this file to .env (gitignored, never committed - C-07) and fill in real values before
# `docker compose up`. Generate each with a proper random source, e.g.:
#   DB_PASSWORD:                     openssl rand -hex 24
#   BLOCKEVIDENCE_JWT_SECRET:        openssl rand -hex 40
#   BLOCKEVIDENCE_ENCRYPTION_MASTER_KEY:  openssl rand -base64 32   (must decode to exactly 32 bytes, F2/F3)

DB_PASSWORD=
BLOCKEVIDENCE_JWT_SECRET=
BLOCKEVIDENCE_ENCRYPTION_MASTER_KEY=

# Optional: the password every seeded dev user (collector@blockevidence.local etc.) shares. Falls back to a
# fixed demo value in docker-compose.yml if left unset - fine for a local demo, not for anything reachable
# beyond localhost.
BLOCKEVIDENCE_DEV_SEED_PASSWORD=
